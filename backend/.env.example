[Template]
PORT=5000
NODE_ENV=development
# On Render, set BACKEND_URL to https://project-tvkl.onrender.com.
BACKEND_URL=http://localhost:5000

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.apmqpgy.mongodb.net/MediCarePlus?retryWrites=true&w=majority

# Demo seeding is opt-in and accepts only this isolated database name.
DEMO_MODE=false
DEMO_MONGODB_URI=mongodb://127.0.0.1:27017/medicare_demo

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Frontend URL (for CORS); space- or comma-separated http(s) origins.
# On Render, FRONTEND_URL must include at least the deployed Vercel origin(s).
# The three origins listed in cors.js are always allowlisted regardless of this
# value, so this variable is advisory in production. Set it to match the exact
# deployed frontend origins:
#   https://project-dvcn656q9-hari-3728.vercel.app
#   https://project-hari-3728.vercel.app
#   http://localhost:5173
FRONTEND_URL=http://localhost:5173
# On Render, set FRONTEND_URL to one or more comma-separated origins, e.g.
# FRONTEND_URL=https://project-dvcn656q9-hari-3728.vercel.app,https://project-hari-3728.vercel.app

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# AI / LLM Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Alternatively for OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Logging
LOG_LEVEL=info
